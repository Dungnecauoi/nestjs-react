// Prisma Schema file cho NestJS Core Framework (Enterprise Auth, Team/Department, Role & Direct Permission)
//
// Biến thể SQLite — chọn bằng `npm run db:use:sqlite` (copy đè lên schema.prisma). Khi sửa
// model, sửa CẢ 3 file (schema.mysql.prisma, schema.postgresql.prisma, schema.sqlite.prisma)
// để không bị lệch — Prisma bắt buộc datasource.provider cố định lúc generate, không thể dùng
// chung 1 file cho nhiều DB engine cùng lúc. Khác schema.mysql.prisma đúng 1 điểm: bỏ hết
// @db.Text (SQLite không phân biệt TEXT/VARCHAR, connector không nhận native type này).
// Phù hợp dev/self-host quy mô nhỏ — không khuyến khích production nhiều người dùng ghi đồng
// thời (SQLite khoá ghi đơn luồng).
//
// DATABASE_URL cho SQLite dùng dạng file, vd: DATABASE_URL="file:./dev.db"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Model Phòng Ban / Team (Department)
model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  parentId    String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")

  users       UserDepartment[]

  @@map("departments")
}

// 2. Model Người Dùng (User)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatar              String?
  phone               String?
  identityCard        String?   @map("identity_card")
  gender              String?
  dateOfBirth         DateTime? @map("date_of_birth")
  address             String?
  bio                 String?
  isActive            Boolean   @default(true)
  twoFactorSecret     String?   @map("two_factor_secret")
  isTwoFactorEnabled  Boolean   @default(false) @map("is_two_factor_enabled")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roles       UserRole[]
  permissions UserPermission[] // Gán Permission TRỰC TIẾP cho User
  departments UserDepartment[]
  sessions    UserSession[]
  notifications Notification[]
  auditLogs   AuditLog[]
  tokens      UserToken[]

  @@map("users")
}

// 2.0 Model Token dùng chung (Quên mật khẩu / Xác minh Email)
model UserToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    // 'PASSWORD_RESET' | 'EMAIL_VERIFY'
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

// 2.1 Model Phiên Đăng Nhập Đa Thiết Bị (Multi-Device User Sessions)
model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  isRevoked Boolean  @default(false) @map("is_revoked")
  rememberMe Boolean @default(false) @map("remember_me")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// 3. Model Vai Trò (Role - Ví dụ: Admin, Manager, Accountant)
model Role {
  id          String    @id @default(uuid())
  code        String    @unique // 'super-admin', 'admin', 'manager'
  name        String
  description String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// 4. Model Quyền Hạn (Permission - Ví dụ: employee:read, employee:create)
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // 'employee:read', 'employee:create'
  name        String
  module      String   // 'employee', 'account', 'order'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[] // Gán Permission TRỰC TIẾP cho User

  @@map("permissions")
}

// 5. Bảng trung gian Gắn User theo Role (User -> Roles)
model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// 6. Bảng trung gian Gắn Permission TRỰC TIẾP cho User (User -> Direct Permissions)
model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// 7. Bảng trung gian Gắn Permission vào Role (Role -> Permissions)
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 8. Bảng trung gian Gắn User vào Phòng ban / Team (User -> Departments)
model UserDepartment {
  userId       String
  departmentId String
  isPrimary    Boolean @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_departments")
}

// 9. Model Quản Lý File / Media (Media Manager)
model Media {
  id          String    @id @default(uuid())
  filename    String
  filepath    String
  url         String
  mimetype    String
  size        Int
  disk        String    @default("local")
  title       String?
  altText     String?
  caption     String?
  description String?
  createdById String?

  // Xử lý nền (convert WebP cho ảnh, thumbnail cho video) qua queue 'media-processing' —
  // pending ngay sau upload, completed/failed khi worker xử lý xong (hoặc xử lý đồng bộ ngay
  // nếu không có Redis, xem MediaService.createMedia()/MediaProcessor).
  thumbnailUrl     String? @map("thumbnail_url")
  processingStatus String  @default("completed") @map("processing_status")

  attachments MediaAttachment[]

  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("media")
}

// Bảng pivot many-to-many: 1 Media dùng chung được ở NHIỀU nơi cùng lúc (đúng tinh thần thư
// viện media dùng chung kiểu WordPress) — KHÔNG nhúng attachableType/attachableId thẳng trên
// Media (làm vậy thì 1 ảnh chỉ gán được đúng 1 chỗ, gán chỗ thứ 2 sẽ ghi đè mất chỗ đầu).
// Gán/huỷ gán qua MediaService.attachTo()/detach()/getAttached() dùng chung cho mọi module.
model MediaAttachment {
  id             String   @id @default(uuid())
  mediaId        String   @map("media_id")
  media          Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  attachableType String   @map("attachable_type")
  attachableId   String   @map("attachable_id")
  collection     String   @default("default")
  createdAt      DateTime @default(now())

  @@index([mediaId])
  @@index([attachableType, attachableId, collection])
  @@map("media_attachments")
}

// 10. Model Cấu Hình Hệ Thống (Global Options - wp_options Architecture)
model Option {
  id          String   @id @default(uuid())
  optionName  String   @unique @map("option_name")
  optionValue String? @map("option_value")
  autoload    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("options")
}

// 11. Model Thông Báo Hệ Thống (Notification System)
model Notification {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  title     String
  content   String
  type      String    @default("info") // 'info', 'success', 'warning', 'error', 'system'
  data      String?         // JSON metadata string (link, entityId, etc.)
  isRead    Boolean   @default(false)  @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now())  @map("created_at")
  updatedAt DateTime  @updatedAt       @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// 12. Model Nhật Ký Thao Tác Hệ Thống (Audit Trail & History Diff)
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  action      String   // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', 'LOGOUT'
  module      String   // 'user', 'role', 'department', 'media', 'setting'
  entityId    String?  @map("entity_id")
  beforeState String? @map("before_state") // JSON state trước khi sửa
  afterState  String? @map("after_state")  // JSON state sau khi sửa
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// 13. Model API Key cho 3rd Party / Mobile App Integration
model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  keyHash     String    @map("key_hash")
  permissions String? // JSON array string của permissions hoặc '*'
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("api_keys")
}

// 14. Model Webhook Engine (3rd-Party Event Subscriptions)
model Webhook {
  id              String    @id @default(uuid())
  name            String
  url             String
  secret          String?
  events          String // JSON array string mảng các sự kiện: ['user.created', 'order.completed', '*']
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("webhooks")
}




