# ==========================================
# 1. APPLICATION & I18N CONFIG
# ==========================================
APP_NAME="ECOMCX ERP Nest"
APP_ENV=development
APP_KEY=base64:f2S6zbRT4V3/o30zlRgUhv9X0ZlxP6UndlgCshhxkk8=
APP_DEBUG=true
APP_PORT=3000
APP_URL=http://127.0.0.1:3000
API_PREFIX=api/v1

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_CURRENCY=VND

# ==========================================
# 2. LOGGING CONFIG
# ==========================================
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_MAX_FILES=14d

# ==========================================
# 3. AUTHENTICATION & SESSION CONFIG
# ==========================================
AUTH_DRIVER=jwt-bearer
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

ENABLE_CSRF=false

# ==========================================
# 4. DATABASE CONFIG
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nest_db
DB_USERNAME=root
DB_PASSWORD=secret

DATABASE_URL="mysql://root:secret@127.0.0.1:3306/nest_db"

# ==========================================
# 5. CACHE STORE
# ==========================================
CACHE_STORE=memory
CACHE_PREFIX=app_cache_

# ==========================================
# 6. QUEUE & BROADCAST
# ==========================================
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=websocket

# ==========================================
# 7. REDIS CONFIG
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ==========================================
# 8. FILE STORAGE DISK
# ==========================================
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# 9. MAIL CONFIG
# ==========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# 10. SECURITY & RATE LIMITING
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==========================================
# 11. CORS
# Danh sách Origin được phép gọi API, cách nhau bởi dấu phẩy.
# Để trống ở development sẽ fallback cho phép mọi Origin (không dùng ở production).
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
