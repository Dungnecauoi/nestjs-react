// Prisma Schema file cho NestJS Core Framework (Enterprise Auth, Team/Department, Role & Direct Permission)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Model Phòng Ban / Team (Department)
model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  users UserDepartment[]

  @@map("departments")
}

// 2. Model Người Dùng (User)
model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  avatar             String?
  phone              String?
  identityCard       String?   @map("identity_card")
  gender             String?
  dateOfBirth        DateTime? @map("date_of_birth")
  address            String?   @db.Text
  bio                String?   @db.Text
  isActive           Boolean   @default(true)
  twoFactorSecret    String?   @map("two_factor_secret")
  isTwoFactorEnabled Boolean   @default(false) @map("is_two_factor_enabled")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles       UserRole[]
  permissions UserPermission[] // Gán Permission TRỰC TIẾP cho User
  departments UserDepartment[]
  sessions    UserSession[]

  @@map("users")
}

// 2.1 Model Phiên Đăng Nhập Đa Thiết Bị (Multi-Device User Sessions)
model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") @db.Text
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// 3. Model Vai Trò (Role - Ví dụ: Admin, Manager, Accountant)
model Role {
  id          String   @id @default(uuid())
  code        String   @unique // 'super-admin', 'admin', 'manager'
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// 4. Model Quyền Hạn (Permission - Ví dụ: employee:read, employee:create)
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // 'employee:read', 'employee:create'
  name        String
  module      String // 'employee', 'account', 'order'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[] // Gán Permission TRỰC TIẾP cho User

  @@map("permissions")
}

// 5. Bảng trung gian Gắn User theo Role (User -> Roles)
model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// 6. Bảng trung gian Gắn Permission TRỰC TIẾP cho User (User -> Direct Permissions)
model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// 7. Bảng trung gian Gắn Permission vào Role (Role -> Permissions)
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 8. Bảng trung gian Gắn User vào Phòng ban / Team (User -> Departments)
model UserDepartment {
  userId       String
  departmentId String
  isPrimary    Boolean @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_departments")
}

// 9. Model Quản Lý File / Media (Media Manager)
model Media {
  id          String   @id @default(uuid())
  filename    String
  filepath    String
  url         String
  mimetype    String
  size        Int
  disk        String   @default("local")
  title       String?
  altText     String?
  caption     String?
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media")
}

// 10. Model Cấu Hình Hệ Thống (Global Options - wp_options Architecture)
model Option {
  id          String   @id @default(uuid())
  optionName  String   @unique @map("option_name")
  optionValue String?  @map("option_value") @db.Text
  autoload    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("options")
}
